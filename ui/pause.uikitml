<panel width="320" height="260" backgroundColor="#000a18" backgroundOpacity="0.95" borderRadius="12" borderColor="#00ffff" borderWidth="2" flexDirection="column" alignItems="center" padding="20" gap="14">
  <text content="PAUSED" fontSize="32" fontWeight="bold" color="#00ffff" marginBottom="10"/>
  <panel id="btn-resume" width="240" height="44" backgroundColor="#003344" backgroundOpacity="0.8" borderRadius="8" borderColor="#00ffff" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer">
    <text content="RESUME" fontSize="20" fontWeight="bold" color="#00ffff"/>
  </panel>
  <panel id="btn-quit" width="240" height="44" backgroundColor="#330011" backgroundOpacity="0.8" borderRadius="8" borderColor="#ff4444" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer">
    <text content="QUIT" fontSize="20" fontWeight="bold" color="#ff4444"/>
  </panel>
  <text content="ESC / P to resume" fontSize="12" color="#668888"/>
</panel>
