<panel width="380" height="460" backgroundColor="#000a18" backgroundOpacity="0.95" borderRadius="12" borderColor="#00ffff" borderWidth="2" flexDirection="column" alignItems="center" padding="16" gap="8">
  <text content="GAME OVER" fontSize="32" fontWeight="bold" color="#ff4444" marginBottom="6"/>
  <text id="txt-final-score" content="SCORE: 0" fontSize="22" fontWeight="bold" color="#00ffff"/>
  <text id="txt-final-wave" content="WAVE: 1" fontSize="16" color="#cccccc"/>
  <text id="txt-final-kills" content="ENEMIES: 0" fontSize="14" color="#44ff44"/>
  <text id="txt-final-eggs" content="EGGS: 0" fontSize="14" color="#ffffff"/>
  <text id="txt-final-combo" content="BEST COMBO: x0" fontSize="14" color="#ffcc00"/>
  <text id="txt-powerups" content="POWER-UPS: 0" fontSize="14" color="#ff44ff"/>
  <text id="txt-kill-streak" content="BEST STREAK: 0x" fontSize="14" color="#ff8844"/>
  <text id="txt-best" content="HIGH SCORE: 0" fontSize="16" fontWeight="bold" color="#ff88cc" marginTop="6"/>
  <panel id="btn-retry" width="240" height="42" backgroundColor="#003344" backgroundOpacity="0.8" borderRadius="8" borderColor="#00ffff" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer" marginTop="8">
    <text content="RETRY" fontSize="18" fontWeight="bold" color="#00ffff"/>
  </panel>
  <panel id="btn-menu" width="240" height="42" backgroundColor="#002233" backgroundOpacity="0.7" borderRadius="8" borderColor="#00aaaa" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer">
    <text content="MENU" fontSize="18" color="#00aaaa"/>
  </panel>
</panel>
