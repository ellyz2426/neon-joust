<panel width="380" height="400" backgroundColor="#000a18" backgroundOpacity="0.95" borderRadius="12" borderColor="#00ffff" borderWidth="2" flexDirection="column" alignItems="center" padding="16" gap="10">
  <text content="SETTINGS" fontSize="28" fontWeight="bold" color="#00ffff" marginBottom="8"/>
  <panel id="btn-sound" width="260" height="40" backgroundColor="#002233" backgroundOpacity="0.8" borderRadius="6" borderColor="#00aaaa" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer">
    <text id="txt-sound" content="SOUND: ON" fontSize="16" color="#00aaaa"/>
  </panel>
  <panel id="btn-music" width="260" height="40" backgroundColor="#002233" backgroundOpacity="0.8" borderRadius="6" borderColor="#00aaaa" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer">
    <text id="txt-music" content="MUSIC: ON" fontSize="16" color="#00aaaa"/>
  </panel>
  <panel id="btn-color" width="260" height="40" backgroundColor="#002233" backgroundOpacity="0.8" borderRadius="6" borderColor="#00aaaa" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer">
    <text id="txt-color" content="COLOR: CYAN" fontSize="16" color="#00aaaa"/>
  </panel>
  <panel id="btn-diff" width="260" height="40" backgroundColor="#002233" backgroundOpacity="0.8" borderRadius="6" borderColor="#00aaaa" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer">
    <text id="txt-diff" content="DIFFICULTY: NORMAL" fontSize="16" color="#00aaaa"/>
  </panel>
  <panel id="btn-back" width="200" height="38" backgroundColor="#003344" backgroundOpacity="0.8" borderRadius="8" borderColor="#00ffff" borderWidth="1" justifyContent="center" alignItems="center" cursor="pointer" marginTop="10">
    <text content="BACK" fontSize="16" fontWeight="bold" color="#00ffff"/>
  </panel>
</panel>
